# Copy to .env and fill in. Only the first two are needed to run the project.
#
#   cp backend/.env.example backend/.env

# ---- Required ----------------------------------------------------------------
OPENAI_API_KEY=
ELEVENLABS_API_KEY=


# ---- Storage -----------------------------------------------------------------
# "files" runs entirely off backend/data/ with no external database, which is
# how the repo works out of the box: the demo agent, its tests, the mocked calls
# and the mined issues are all committed. "postgres" needs SUPABASE_DB_URL.
STORE_BACKEND=files

# Supabase. The direct db.<ref> host no longer resolves for new projects — take
# the *session pooler* URI from Dashboard → Connect, and URL-encode the password
# (an @ in it must become %40, or the parser splits on the wrong one).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=


# ---- Sign-in -----------------------------------------------------------------
# Off by default for local work. With auth on, every request needs a session and
# each account gets its own workspace.
AUTH_DISABLED=1

# Signs session cookies and encrypts stored calendar tokens. Any long random
# string; changing it invalidates both.
SESSION_SECRET=

# Anyone can sign up by phone. Set to 0 to close signups.
AUTH_OPEN_SIGNUP=1

# Break-glass for whoever runs the deployment, shown only when SMS is
# unavailable. Leave empty once phone sign-in works.
AUTH_PASSWORD=


# ---- Telephony (optional) ------------------------------------------------------
# Without these the agent still takes browser test calls; it just can't answer a
# real phone.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# The account auth token, distinct from the API key secret above. Twilio signs
# webhooks with this; without it the endpoints fall back to the URL secret and
# cannot detect a tampered body.
TWILIO_AUTH_TOKEN=

# Sends sign-in codes. Twilio Verify uses its own sender pool, so this works
# before the account owns any number.
TWILIO_VERIFY_SERVICE_SID=

TWILIO_PHONE_NUMBER=
# Random string in the webhook path, so a stranger who guesses the hostname
# can't drive the agent.
TWILIO_WEBHOOK_SECRET=

# Where Twilio can reach this deployment. Must be a real certificate — Twilio
# rejects self-signed, so localhost won't do.
PUBLIC_BASE_URL=


# ---- Google Calendar (optional) ------------------------------------------------
# Authorised redirect URI: <PUBLIC_BASE_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---- Serving -------------------------------------------------------------------
# Behind a reverse proxy, bind the loopback and let the proxy terminate TLS.
HOST=0.0.0.0
PORT=7860
